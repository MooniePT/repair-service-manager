# ============================================================
#  MODELO de ficheiro .env  —  copie para ".env" e preencha
# ============================================================
#  O ficheiro ".env" verdadeiro NUNCA deve ser partilhado nem
#  enviado para fora da máquina: contém segredos.
#  O ".env.example" (este) pode ficar no projeto — não tem segredos.
# ------------------------------------------------------------

# Chave secreta da aplicação (sessões/cookies).
# Gere uma assim (uma vez):
#   docker run --rm python:3.12-slim python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cole-aqui-uma-chave-de-64-caracteres

# Token do Cloudflare Tunnel (só necessário no modo "produção/externo").
# Obtém-se no painel Cloudflare ao criar o túnel (ver docs/CLOUDFLARE.md).
TUNNEL_TOKEN=cole-aqui-o-token-do-cloudflare
